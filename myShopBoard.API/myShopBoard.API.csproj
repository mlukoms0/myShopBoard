<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TargetFramework / Nullable / ImplicitUsings come from ..\Directory.Build.props
    Package VERSIONS come from ..\Directory.Packages.props
    That is why the PackageReference lines below carry no Version attribute.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <!--
      This project references Domain ONLY - deliberately NOT Data.
      Controllers therefore cannot inject a repository or the DbContext, which makes it
      structurally impossible to bypass the business rules and yard scoping that live in
      the Domain services. See ZDocumentation/ARCHITECTURE.md section 4.

      (myStorage's API project references both Domain AND Data, and 10 of its 30 controllers
      reach straight into the data layer as a result.)
    -->
    <ProjectReference Include="..\myShopBoard.Domain\myShopBoard.Domain.csproj" />
  </ItemGroup>

</Project>
